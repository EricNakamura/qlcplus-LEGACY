 <class>App</class>
 <widget class="QMainWindow" name="App">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Q Light Controller Plus</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="m_centralLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <item>
     <widget class="QTabWidget" name="m_tab">
      <property name="tabPosition">
       <enum>QTabWidget::TabPosition::East</enum>
      </property>
      <property name="iconSize">
       <size>
        <width>24</width>
        <height>24</height>
       </size>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QToolBar" name="m_toolbar">
   <property name="windowTitle">
    <string>Workspace</string>
   </property>
   <property name="movable">
    <bool>false</bool>
   </property>
   <property name="floatable">
    <bool>false</bool>
   </property>
   <property name="allowedAreas">
    <set>Qt::ToolBarArea::TopToolBarArea</set>
   </property>
   <property name="contextMenuPolicy">
    <enum>Qt::ContextMenuPolicy::CustomContextMenu</enum>
   </property>
   <attribute name="toolBarArea">
    <enum>TopToolBarArea</enum>
   </attribute>
   <attribute name="toolBarBreak">
    <bool>false</bool>
   </attribute>
   <addaction name="m_fileNewAction"/>
   <addaction name="m_fileOpenAction"/>
   <addaction name="m_fileSaveAction"/>
   <addaction name="m_fileSaveAsAction"/>
   <addaction name="separator"/>
   <addaction name="m_controlMonitorAction"/>
   <addaction name="m_addressToolAction"/>
   <addaction name="separator"/>
   <addaction name="m_controlFullScreenAction"/>
   <addaction name="m_helpIndexAction"/>
   <addaction name="m_helpAboutAction"/>
   <addaction name="m_quitAction"/>
   <addaction name="m_dumpDmxAction"/>
   <addaction name="m_liveEditAction"/>
   <addaction name="m_liveEditVirtualConsoleAction"/>
   <addaction name="separator"/>
   <addaction name="m_controlPanicAction"/>
   <addaction name="separator"/>
   <addaction name="m_controlBlackoutAction"/>
   <addaction name="separator"/>
   <addaction name="m_modeToggleAction"/>
  </widget>
  <action name="m_fileNewAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/filenew.png</normaloff>:/filenew.png</iconset>
   </property>
   <property name="text">
    <string>&amp;New</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+N</string>
   </property>
  </action>
  <action name="m_fileOpenAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/fileopen.png</normaloff>:/fileopen.png</iconset>
   </property>
   <property name="text">
    <string>&amp;Open</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+O</string>
   </property>
  </action>
  <action name="m_fileSaveAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/filesave.png</normaloff>:/filesave.png</iconset>
   </property>
   <property name="text">
    <string>&amp;Save</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+S</string>
   </property>
  </action>
  <action name="m_fileSaveAsAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/filesaveas.png</normaloff>:/filesaveas.png</iconset>
   </property>
   <property name="text">
    <string>Save &amp;As...</string>
   </property>
  </action>
  <action name="m_modeToggleAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/operate.png</normaloff>:/operate.png</iconset>
   </property>
   <property name="text">
    <string>&amp;Operate</string>
   </property>
   <property name="toolTip">
    <string>Switch to operate mode</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+F12</string>
   </property>
  </action>
  <action name="m_controlMonitorAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/monitor.png</normaloff>:/monitor.png</iconset>
   </property>
   <property name="text">
    <string>&amp;Monitor</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+M</string>
   </property>
  </action>
  <action name="m_addressToolAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/diptool.png</normaloff>:/diptool.png</iconset>
   </property>
   <property name="text">
    <string>Address Tool</string>
   </property>
  </action>
  <action name="m_controlBlackoutAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/blackout.png</normaloff>:/blackout.png</iconset>
   </property>
   <property name="text">
    <string>Toggle &amp;Blackout</string>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
  </action>
  <action name="m_liveEditAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/liveedit.png</normaloff>:/liveedit.png</iconset>
   </property>
   <property name="text">
    <string>Live edit a function</string>
   </property>
  </action>
  <action name="m_liveEditVirtualConsoleAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/liveedit_vc.png</normaloff>:/liveedit_vc.png</iconset>
   </property>
   <property name="text">
    <string>Toggle Virtual Console Live edit</string>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
  </action>
  <action name="m_dumpDmxAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/add_dump.png</normaloff>:/add_dump.png</iconset>
   </property>
   <property name="text">
    <string>Dump DMX values to a function</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+D</string>
   </property>
  </action>
  <action name="m_controlPanicAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/panic.png</normaloff>:/panic.png</iconset>
   </property>
   <property name="text">
    <string>Stop ALL functions!</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+Esc</string>
   </property>
  </action>
  <action name="m_controlFullScreenAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/fullscreen.png</normaloff>:/fullscreen.png</iconset>
   </property>
   <property name="text">
    <string>Toggle Full Screen</string>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="shortcut">
    <string>Ctrl+F11</string>
   </property>
  </action>
  <action name="m_helpIndexAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/help.png</normaloff>:/help.png</iconset>
   </property>
   <property name="text">
    <string>&amp;Index</string>
   </property>
   <property name="shortcut">
    <string>Shift+F1</string>
   </property>
  </action>
  <action name="m_helpAboutAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/qlcplus.png</normaloff>:/qlcplus.png</iconset>
   </property>
   <property name="text">
    <string>&amp;About QLC+</string>
   </property>
  </action>
  <action name="m_quitAction">
   <property name="icon">
    <iconset resource="qlcui.qrc">
     <normaloff>:/exit.png</normaloff>:/exit.png</iconset>
   </property>
   <property name="text">
    <string>Quit QLC+</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Alt+Backspace</string>
   </property>
  </action>
 </widget>
 <resources>
  <include location="qlcui.qrc"/>
 </resources>
 <connections/>
</ui>
